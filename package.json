{
  "name": "shallotwham",
  "version": "1.8.0",
  "description": "ShallotWHAM Dual-Engine Synth & Whammy Station",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/validate-modules.js && node scripts/test-modular-dsp.js && node scripts/test-keys-audio.js",
    "validate": "node scripts/validate-modules.js",
    "remaster": "node scripts/remaster-all-modules.js && node scripts/sync-modules.js",
    "build": "electron-builder --win portable"
  },
  "author": "Shallot",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.shallot.shallotwham",
    "productName": "ShallotWHAM",
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "shallot-theme.css",
      "shallot-theme.json",
      "app.js",
      "modules/**/*"
    ],
    "portable": {
      "artifactName": "ShallotWHAM.exe"
    }
  }
}
